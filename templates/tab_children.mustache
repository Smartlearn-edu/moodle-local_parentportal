    Parent Portal - Children Tab
}}
<div class="parentportal-tab-content parentportal-tab-children">
    <!-- Top Action Bar -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div>
            <h4 class="fw-bold mb-1 text-dark">{{#str}}childroster, local_parentportal{{/str}}</h4>
            <p class="text-muted small mb-0">{{#str}}managechildren, local_parentportal{{/str}}</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-primary rounded-pill px-3 py-2 btn-sm" data-bs-toggle="modal" data-bs-target="#addChildModal">
                <i class="fa fa-plus me-1"></i> {{#str}}addnewchild, local_parentportal{{/str}}
            </button>
            <button type="button" class="btn btn-outline-secondary rounded-pill px-3 py-2 btn-sm" data-bs-toggle="modal" data-bs-target="#linkChildModal">
                <i class="fa fa-link me-1"></i> {{#str}}linkchild, local_parentportal{{/str}}
            </button>
        </div>
    </div>

    {{#haschildren}}
    <!-- Children Roster Grid -->
    <div class="row g-4">
        {{#childrenlist}}
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 parentportal-child-card position-relative overflow-hidden {{#isactive}}border-2 border-primary shadow{{/isactive}}">
                {{#isactive}}
                <div class="position-absolute top-0 end-0 bg-primary text-white px-3 py-1 rounded-bottom-start small fw-semibold">
                    <i class="fa fa-check-circle me-1"></i> {{#str}}activechild, local_parentportal{{/str}}
                </div>
                {{/isactive}}
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="parentportal-avatar-wrap">
                                {{{avatar}}}
                            </div>
                            <div>
                                <h5 class="fw-bold mb-0 text-dark">{{fullname}}</h5>
                                {{#gradelabel}}
                                <span class="badge bg-primary-subtle text-primary rounded-pill mt-1">{{gradelabel}}</span>
                                {{/gradelabel}}
                            </div>
                        </div>

                        <ul class="list-unstyled small text-muted my-3 border-top border-bottom py-2">
                            <li class="d-flex justify-content-between py-1">
                                <span><i class="fa fa-envelope me-1 text-secondary"></i> {{#str}}email, local_parentportal{{/str}}:</span>
                                <span class="text-dark fw-medium">{{email}}</span>
                            </li>
                            <li class="d-flex justify-content-between py-1">
                                <span><i class="fa fa-book me-1 text-secondary"></i> {{#str}}kpi_enrolledcourses, local_parentportal{{/str}}:</span>
                                <span class="badge bg-secondary-subtle text-secondary rounded-pill">{{enrolledcount}}</span>
                            </li>
                            <li class="d-flex justify-content-between py-1">
                                <span><i class="fa fa-calendar me-1 text-secondary"></i> {{#str}}dateadded, local_parentportal{{/str}}:</span>
                                <span class="text-dark">{{dateadded}}</span>
                            </li>
                        </ul>
                    </div>

                    <div class="d-flex gap-2 flex-wrap pt-2">
                        <a href="{{config.wwwroot}}/local/parentportal/index.php?tab=academics&childid={{childid}}" class="btn btn-outline-primary btn-sm flex-fill rounded-pill">
                            <i class="fa fa-graduation-cap me-1"></i> {{#str}}tab_academics, local_parentportal{{/str}}
                        </a>
                        <a href="{{config.wwwroot}}/local/parentportal/studentcard.php?childid={{childid}}" class="btn btn-light btn-sm flex-fill rounded-pill border text-secondary">
                            <i class="fa fa-id-card me-1"></i> {{#str}}studentcard, local_parentportal{{/str}}
                        </a>
                        {{^isactive}}
                        <a href="{{config.wwwroot}}/local/parentportal/index.php?tab=dashboard&childid={{childid}}" class="btn btn-outline-secondary btn-sm rounded-pill" title="{{#str}}switchchild, local_parentportal{{/str}}">
                            <i class="fa fa-arrow-right"></i>
                        </a>
                        {{/isactive}}
                    </div>
                </div>
            </div>
        </div>
        {{/childrenlist}}
    </div>
    {{/haschildren}}

    {{^haschildren}}
    <div class="card border-0 shadow-sm rounded-4 p-5 text-center my-4">
        <p class="text-muted mb-3">{{#str}}nochildren, local_parentportal{{/str}}</p>
        <div>
            <button type="button" class="btn btn-primary rounded-pill px-4 py-2" data-bs-toggle="modal" data-bs-target="#addChildModal">
                <i class="fa fa-plus me-1"></i> {{#str}}addnewchild, local_parentportal{{/str}}
            </button>
        </div>
    </div>
    {{/haschildren}}
</div>
