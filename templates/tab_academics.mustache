{{!
    This file is part of Moodle - http://moodle.org/
    Parent Portal - Academic Progress & Performance Hub (Phase 2)
}}
<div class="parentportal-tab-content parentportal-tab-academics">
    {{#haschildren}}
    {{#activechild}}
    <!-- Academic Hub Header & Metric Pills -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 parentportal-academic-header">
        <div class="card-body p-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="parentportal-avatar-wrap">
                    {{{avatar}}}
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <h4 class="fw-bold mb-0 text-dark">{{fullname}}</h4>
                        {{#gradelabel}}
                        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1">{{gradelabel}}</span>
                        {{/gradelabel}}
                    </div>
                    <p class="text-muted mb-0 small mt-1">
                        {{#str}}academics_desc, local_parentportal{{/str}}
                    </p>
                </div>
            </div>

            <!-- Metric Quick Badges -->
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <div class="bg-light border rounded-pill px-3 py-2 text-center">
                    <span class="text-muted small d-block lh-1">{{#str}}total_courses, local_parentportal{{/str}}</span>
                    <strong class="fs-6 text-dark">{{academicsummary.total_courses}}</strong>
                </div>
                <div class="bg-light border rounded-pill px-3 py-2 text-center">
                    <span class="text-muted small d-block lh-1">{{#str}}overall_average_grade, local_parentportal{{/str}}</span>
                    <strong class="fs-6 text-success">{{academicsummary.overall_grade_str}}</strong>
                </div>
                <div class="bg-light border rounded-pill px-3 py-2 text-center">
                    <span class="text-muted small d-block lh-1">{{#str}}kpi_attendance, local_parentportal{{/str}}</span>
                    <strong class="fs-6 text-info">{{childattendance.ratestr}}</strong>
                </div>
            </div>
        </div>
    </div>

    <!-- High-Impact Performance Report Launchers -->
    <div class="row g-3 mb-4">
        <!-- Launcher 1: Academic Transcript & GPA -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 parentportal-launcher-card hover-shadow transition">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div class="rounded-circle bg-success-subtle text-success p-3 d-inline-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                                <i class="fa fa-file-invoice fa-lg"></i>
                            </div>
                            <span class="badge bg-success-subtle text-success rounded-pill small px-2 py-1">GPA & Grades</span>
                        </div>
                        <h5 class="fw-bold text-dark mb-2">{{#str}}report_gradebook_title, local_parentportal{{/str}}</h5>
                        <p class="text-muted small mb-3">
                            {{#str}}report_gradebook_desc, local_parentportal{{/str}}
                        </p>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="{{config.wwwroot}}/report/studentgrades/index.php?userid={{childid}}" class="btn btn-outline-success btn-sm rounded-pill px-3 flex-grow-1">
                            <i class="fa fa-external-link-alt me-1"></i> {{#str}}report_gradebook_btn, local_parentportal{{/str}}
                        </a>
                        <a href="{{config.wwwroot}}/report/studentgrades/index.php?userid={{childid}}&action=export" class="btn btn-light btn-sm rounded-pill border px-2" title="Export">
                            <i class="fa fa-download text-muted"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Launcher 2: AI Academic Insights -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 parentportal-launcher-card hover-shadow transition">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div class="rounded-circle bg-primary-subtle text-primary p-3 d-inline-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                                <i class="fa fa-robot fa-lg"></i>
                            </div>
                            <span class="badge bg-primary-subtle text-primary rounded-pill small px-2 py-1">AI Powered</span>
                        </div>
                        <h5 class="fw-bold text-dark mb-2">{{#str}}report_ai_title, local_parentportal{{/str}}</h5>
                        <p class="text-muted small mb-3">
                            {{#str}}report_ai_desc, local_parentportal{{/str}}
                        </p>
                    </div>
                    <div>
                        <a href="{{config.wwwroot}}/report/studentgrades/index.php?userid={{childid}}&action=analyze" class="btn btn-outline-primary btn-sm rounded-pill px-3 w-100">
                            <i class="fa fa-magic me-1"></i> {{#str}}report_ai_btn, local_parentportal{{/str}}
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Launcher 3: 360° Visual Analytics (Smart Dashboard) -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 parentportal-launcher-card hover-shadow transition">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div class="rounded-circle bg-info-subtle text-info p-3 d-inline-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                                <i class="fa fa-chart-pie fa-lg"></i>
                            </div>
                            <span class="badge bg-info-subtle text-info rounded-pill small px-2 py-1">Smart Dashboard</span>
                        </div>
                        <h5 class="fw-bold text-dark mb-2">{{#str}}report_analytics_title, local_parentportal{{/str}}</h5>
                        <p class="text-muted small mb-3">
                            {{#str}}report_analytics_desc, local_parentportal{{/str}}
                        </p>
                    </div>
                    <div>
                        <a href="{{config.wwwroot}}/local/smartdashboard/index.php?role=parent&viewuser={{childid}}" class="btn btn-outline-info btn-sm rounded-pill px-3 w-100">
                            <i class="fa fa-chart-line me-1"></i> {{#str}}report_analytics_btn, local_parentportal{{/str}}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Course Grid & Sidebar Info -->
    <div class="row g-4">
        <!-- Left: Course Cards Grid -->
        <div class="col-lg-8">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="fa fa-book-reader text-primary me-2"></i>{{#str}}academics_title, local_parentportal{{/str}}
                </h5>
                <span class="badge bg-light text-muted border rounded-pill">{{academicsummary.total_courses}} courses</span>
            </div>

            {{#haschildcourses}}
            <div class="row g-3">
                {{#childcourses}}
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden parentportal-course-card">
                        <!-- Course Image Banner -->
                        <div class="parentportal-course-header-banner position-relative">
                            {{#hasimage}}
                            <img src="{{courseimage}}" alt="{{fullname}}" class="w-100 parentportal-course-img">
                            {{/hasimage}}
                            {{^hasimage}}
                            <div class="parentportal-course-img-fallback d-flex align-items-center justify-content-center text-white">
                                <i class="fa fa-graduation-cap fa-3x opacity-50"></i>
                            </div>
                            {{/hasimage}}
                            <div class="position-absolute top-0 start-0 m-3">
                                <span class="badge bg-dark bg-opacity-75 text-white rounded-pill px-2 py-1 small">
                                    {{categoryname}}
                                </span>
                            </div>
                            <div class="position-absolute top-0 end-0 m-3">
                                <span class="badge {{gradebadge}} rounded-pill px-3 py-1 shadow-sm font-monospace">
                                    {{#str}}grade, local_parentportal{{/str}}: {{gradestr}}
                                </span>
                            </div>
                        </div>

                        <!-- Course Details Body -->
                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <div>
                                <h6 class="fw-bold text-dark mb-2 text-truncate-2" title="{{fullname}}">
                                    {{fullname}}
                                </h6>

                                <!-- Progress Section -->
                                <div class="my-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="text-muted small fw-semibold">{{#str}}course_completion, local_parentportal{{/str}}</span>
                                        {{#hasprogress}}
                                        <span class="small fw-bold {{#iscompleted}}text-success{{/iscompleted}}{{^iscompleted}}text-primary{{/iscompleted}}">
                                            {{progress}}%
                                        </span>
                                        {{/hasprogress}}
                                        {{^hasprogress}}
                                        <span class="small text-muted">--</span>
                                        {{/hasprogress}}
                                    </div>
                                    <div class="progress rounded-pill" style="height: 8px;">
                                        {{#hasprogress}}
                                        <div class="progress-bar {{#iscompleted}}bg-success{{/iscompleted}}{{^iscompleted}}bg-primary{{/iscompleted}}" role="progressbar" style="width: {{progress}}%;" aria-valuenow="{{progress}}" aria-valuemin="0" aria-valuemax="100"></div>
                                        {{/hasprogress}}
                                        {{^hasprogress}}
                                        <div class="progress-bar bg-light" role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                                        {{/hasprogress}}
                                    </div>
                                </div>

                                <!-- Instructors -->
                                <div class="pt-2 border-top">
                                    <div class="text-muted small mb-2 fw-semibold">{{#str}}course_instructors, local_parentportal{{/str}}:</div>
                                    {{#hasteachers}}
                                    <div class="d-flex flex-column gap-2">
                                        {{#teachers}}
                                        <div class="d-flex align-items-center justify-content-between bg-light rounded-3 p-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="avatar-small">{{{avatarsmall}}}</div>
                                                <div class="small fw-semibold text-dark text-truncate" style="max-width: 140px;">{{fullname}}</div>
                                            </div>
                                            <div class="d-flex align-items-center gap-1">
                                                {{#hasphone}}
                                                <a href="{{whatsappurl}}" target="_blank" class="btn btn-sm btn-outline-success rounded-circle p-1 d-inline-flex align-items-center justify-content-center" style="width: 28px; height: 28px;" title="WhatsApp">
                                                    <i class="fab fa-whatsapp"></i>
                                                </a>
                                                {{/hasphone}}
                                                <a href="{{messageurl}}" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-0 small" title="{{#str}}askteacher, local_parentportal{{/str}}">
                                                    <i class="fa fa-comment-dots"></i>
                                                </a>
                                            </div>
                                        </div>
                                        {{/teachers}}
                                    </div>
                                    {{/hasteachers}}
                                    {{^hasteachers}}
                                    <span class="text-muted small fst-italic">{{#str}}no_instructors, local_parentportal{{/str}}</span>
                                    {{/hasteachers}}
                                </div>
                            </div>

                            <!-- Course Footer Actions -->
                            <div class="mt-4 pt-3 border-top d-flex gap-2">
                                <a href="{{courseurl}}" class="btn btn-primary btn-sm rounded-pill flex-grow-1">
                                    <i class="fa fa-sign-in-alt me-1"></i> {{#str}}gotocourse, local_parentportal{{/str}}
                                </a>
                                <a href="{{smartcourseurl}}" class="btn btn-outline-secondary btn-sm rounded-pill px-3" title="{{#str}}viewcoursedetails, local_parentportal{{/str}}">
                                    <i class="fa fa-info-circle"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                {{/childcourses}}
            </div>
            {{/haschildcourses}}

            {{^haschildcourses}}
            <!-- Empty Enrolled Courses State -->
            <div class="card border-0 shadow-sm rounded-4 p-5 text-center my-2">
                <div class="rounded-circle bg-light text-muted p-4 d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 72px; height: 72px;">
                    <i class="fa fa-book-open fa-2x"></i>
                </div>
                <h5 class="fw-bold text-dark">{{#str}}nocourses_title, local_parentportal{{/str}}</h5>
                <p class="text-muted small mx-auto" style="max-width: 420px;">
                    {{#str}}nocourses_desc, local_parentportal{{/str}}
                </p>
                <div class="mt-3">
                    <a href="{{config.wwwroot}}/local/smartcatalog/index.php" class="btn btn-primary rounded-pill px-4">
                        <i class="fa fa-store me-1"></i> {{#str}}explorecourses, local_parentportal{{/str}}
                    </a>
                </div>
            </div>
            {{/haschildcourses}}
        </div>

        <!-- Right: Attendance & Deadlines Sidebar -->
        <div class="col-lg-4">
            <!-- Attendance Metric Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="fa fa-calendar-check text-info me-2"></i>{{#str}}attendance_summary, local_parentportal{{/str}}
                    </h6>
                    <span class="badge {{childattendance.badgeclass}} rounded-pill px-2 py-1 small">
                        {{childattendance.statuslabel}}
                    </span>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div>
                            <div class="fs-2 fw-bold text-dark">{{childattendance.ratestr}}</div>
                            <span class="text-muted small">{{#str}}kpi_attendance, local_parentportal{{/str}}</span>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-light text-dark border rounded-pill px-3 py-1">
                                {{childattendance.present}} / {{childattendance.total}} {{#str}}attendance_present, local_parentportal{{/str}}
                            </span>
                        </div>
                    </div>
                    <div class="progress rounded-pill" style="height: 8px;">
                        <div class="progress-bar bg-info" role="progressbar" style="width: {{childattendance.rate}}%;" aria-valuenow="{{childattendance.rate}}" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <button type="button" class="btn btn-outline-info btn-sm rounded-pill w-100 mt-3" data-bs-toggle="modal" data-bs-target="#absenceModal">
                        <i class="fa fa-envelope-open-text me-1"></i> {{#str}}submit_absence_btn, local_parentportal{{/str}}
                    </button>
                </div>
            </div>

            <!-- Absence Requests & Excuse Notes Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="fa fa-file-medical text-primary me-2"></i>{{#str}}absence_request_title, local_parentportal{{/str}}
                    </h6>
                    <button type="button" class="btn btn-outline-primary btn-sm rounded-pill" data-bs-toggle="modal" data-bs-target="#absenceModal">
                        <i class="fa fa-plus me-1"></i> {{#str}}submit_absence_btn, local_parentportal{{/str}}
                    </button>
                </div>
                <div class="card-body p-4">
                    {{#haschildexcuses}}
                    <div class="d-flex flex-column gap-3">
                        {{#childexcuses}}
                        <div class="p-3 rounded-3 border bg-light-subtle">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="badge {{badgeclass}} rounded-pill px-2 py-1 small">{{statuslabel}}</span>
                                <small class="text-muted">{{created_f}}</small>
                            </div>
                            <div class="fw-bold text-dark small mb-1">{{reasonlabel}} &bull; <span class="text-muted">{{dates_f}}</span></div>
                            <div class="text-muted small mb-1"><i class="fa fa-book me-1"></i>{{coursename}}</div>
                            {{#details}}
                            <div class="text-secondary small bg-white p-2 rounded border mt-2" style="font-size: 0.8rem;">
                                {{details}}
                            </div>
                            {{/details}}
                        </div>
                        {{/childexcuses}}
                    </div>
                    {{/haschildexcuses}}
                    {{^haschildexcuses}}
                    <div class="text-center py-3 text-muted">
                        <i class="fa fa-calendar-check fa-2x mb-2 text-muted opacity-50"></i>
                        <p class="small mb-0">{{#str}}absence_no_history, local_parentportal{{/str}}</p>
                    </div>
                    {{/haschildexcuses}}
                </div>
            </div>

            <!-- Upcoming Deadlines Timeline Card -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="fa fa-clock text-warning me-2"></i>{{#str}}deadlines_title, local_parentportal{{/str}}
                    </h6>
                    <span class="badge bg-light text-muted border rounded-pill small">{{activechildkpis.deadlines_count}}</span>
                </div>
                <div class="card-body p-4">
                    {{#haschilddeadlines}}
                    <div class="d-flex flex-column gap-3">
                        {{#childdeadlines}}
                        <div class="p-3 rounded-3 border bg-light-subtle d-flex align-items-start gap-3">
                            <div class="rounded-3 bg-white border text-center p-2" style="min-width: 50px;">
                                <div class="fw-bold fs-6 text-dark lh-1">{{daydate}}</div>
                                <small class="text-muted text-uppercase" style="font-size: 0.65rem;">{{time}}</small>
                            </div>
                            <div class="flex-grow-1 overflow-hidden">
                                <div class="d-flex align-items-center gap-1 mb-1">
                                    <i class="fa {{icon}} small"></i>
                                    <strong class="text-dark small text-truncate" title="{{name}}">{{name}}</strong>
                                </div>
                                <div class="text-muted small text-truncate">{{coursename}}</div>
                                <div class="mt-2 d-flex align-items-center gap-2">
                                    {{#isurgent}}
                                    <span class="badge bg-danger text-white rounded-pill small" style="font-size: 0.7rem;">
                                        <i class="fa fa-exclamation-circle me-1"></i>{{#str}}due_soon, local_parentportal{{/str}}
                                    </span>
                                    {{/isurgent}}
                                    <span class="text-muted small" style="font-size: 0.75rem;">{{timeuntil}}</span>
                                </div>
                            </div>
                        </div>
                        {{/childdeadlines}}
                    </div>
                    {{/haschilddeadlines}}

                    {{^haschilddeadlines}}
                    <div class="text-center py-4">
                        <div class="rounded-circle bg-success-subtle text-success p-3 d-inline-flex align-items-center justify-content-center mb-2" style="width: 56px; height: 56px;">
                            <i class="fa fa-check-circle fa-2x"></i>
                        </div>
                        <h6 class="fw-bold text-dark mt-2 mb-1">{{#str}}nodeadlines_title, local_parentportal{{/str}}</h6>
                        <p class="text-muted small mb-0">
                            {{#str}}nodeadlines_desc, local_parentportal{{/str}}
                        </p>
                    </div>
                    {{/haschilddeadlines}}
                </div>
            </div>
        </div>
    </div>

    <!-- Submit Absence Excuse Modal -->
    <div class="modal fade" id="absenceModal" tabindex="-1" aria-labelledby="absenceModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow rounded-4 overflow-hidden">
                <form action="{{config.wwwroot}}/local/parentportal/index.php" method="post">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="hidden" name="action" value="submitexcuse">
                    <input type="hidden" name="childid" value="{{childid}}">
                    <input type="hidden" name="tab" value="academics">

                    <div class="modal-header bg-primary text-white border-0 px-4 py-3">
                        <div>
                            <h5 class="modal-title fw-bold mb-0" id="absenceModalLabel">
                                <i class="fa fa-calendar-times me-2"></i>{{#str}}absence_modal_title, local_parentportal{{/str}}
                            </h5>
                            <small class="text-white-50">{{fullname}}</small>
                        </div>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body p-4">
                        <p class="text-muted small mb-3">
                            {{#str}}absence_modal_desc, local_parentportal{{/str}}
                        </p>

                        <!-- Reason -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-dark">{{#str}}absence_reason, local_parentportal{{/str}}</label>
                            <select name="reason" class="form-select rounded-3" required>
                                <option value="medical">{{#str}}absence_reason_medical, local_parentportal{{/str}}</option>
                                <option value="family">{{#str}}absence_reason_family, local_parentportal{{/str}}</option>
                                <option value="travel">{{#str}}absence_reason_travel, local_parentportal{{/str}}</option>
                                <option value="appointment">{{#str}}absence_reason_appointment, local_parentportal{{/str}}</option>
                                <option value="other">{{#str}}absence_reason_other, local_parentportal{{/str}}</option>
                            </select>
                        </div>

                        <!-- Course Selector -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-dark">{{#str}}absence_course, local_parentportal{{/str}}</label>
                            <select name="courseid" class="form-select rounded-3">
                                <option value="0">{{#str}}absence_all_courses, local_parentportal{{/str}}</option>
                                {{#childcourses}}
                                <option value="{{id}}">{{fullname}}</option>
                                {{/childcourses}}
                            </select>
                        </div>

                        <!-- Date Range -->
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label fw-semibold small text-dark">{{#str}}absence_startdate, local_parentportal{{/str}}</label>
                                <input type="date" name="startdate" class="form-control rounded-3" value="{{today_date}}" required>
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-semibold small text-dark">{{#str}}absence_enddate, local_parentportal{{/str}}</label>
                                <input type="date" name="enddate" class="form-control rounded-3" value="{{today_date}}" required>
                            </div>
                        </div>

                        <!-- Details / Note -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-dark">{{#str}}absence_details, local_parentportal{{/str}}</label>
                            <textarea name="details" class="form-control rounded-3" rows="3" placeholder="{{#str}}absence_details_placeholder, local_parentportal{{/str}}" required></textarea>
                        </div>
                    </div>

                    <div class="modal-footer border-0 pt-0 px-4 pb-4 d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                            <i class="fa fa-paper-plane me-1"></i> {{#str}}submit_absence_btn, local_parentportal{{/str}}
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    {{/activechild}}
    {{/haschildren}}

    {{^haschildren}}
    <!-- Empty State if Parent has no Children -->
    <div class="card border-0 shadow-sm rounded-4 p-5 text-center my-4">
        <div class="my-4">
