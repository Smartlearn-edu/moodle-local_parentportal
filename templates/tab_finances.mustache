{{!
    This file is part of Moodle - http://moodle.org/
    Parent Portal - Finances & Family Cart Hub (Phase 3)
}}
<div class="parentportal-tab-content parentportal-tab-finances">
    <!-- Family Wallet Balance Header Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 parentportal-wallet-card">
        <div class="card-body p-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-success text-white p-3 d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 64px; height: 64px;">
                    <i class="fa fa-wallet fa-2x"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold text-uppercase tracking-wider">
                        {{#str}}family_wallet_title, local_parentportal{{/str}}
                    </span>
                    <div class="d-flex align-items-baseline gap-2 mt-1">
                        <h2 class="fw-bold mb-0 text-dark">{{walletbalance}}</h2>
                        <span class="text-muted fs-5 fw-semibold">{{walletcurrency}}</span>
                    </div>
                    <small class="text-muted">
                        {{#str}}family_wallet_desc, local_parentportal{{/str}}
                    </small>
                </div>
            </div>

            <div>
                <a href="{{config.wwwroot}}/enrol/wallet/wallet.php" class="btn btn-success rounded-pill px-4 py-2 shadow-sm">
                    <i class="fa fa-plus-circle me-1"></i> {{#str}}topup_btn, local_parentportal{{/str}}
                </a>
            </div>
        </div>
    </div>

    <!-- Family Cart & Summary Row -->
    <div class="row g-4 mb-5">
        <!-- Cart Items Column -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold mb-0 text-dark">
                            <i class="fa fa-shopping-cart text-primary me-2"></i>{{#str}}family_cart_title, local_parentportal{{/str}}
                        </h5>
                        <small class="text-muted">{{#str}}family_cart_desc, local_parentportal{{/str}}</small>
                    </div>
                    {{#hascartitems}}
                    <span class="badge bg-primary rounded-pill px-3 py-1">{{carttotals.items_count}} items</span>
                    {{/hascartitems}}
                </div>

                <div class="card-body p-4">
                    {{#hascartitems}}
                    <div class="table-responsive">
                        <table class="table align-middle parentportal-cart-table mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="border-0 rounded-start">{{#str}}order_course, local_parentportal{{/str}}</th>
                                    <th scope="col" class="border-0">{{#str}}order_child, local_parentportal{{/str}}</th>
                                    <th scope="col" class="border-0 text-end">{{#str}}order_amount, local_parentportal{{/str}}</th>
                                    <th scope="col" class="border-0 rounded-end text-center" style="width: 80px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#cartitems}}
                                <tr>
                                    <td class="py-3">
                                        <div class="fw-bold text-dark">{{coursename}}</div>
                                        <small class="text-muted">{{courseshortname}}</small>
                                    </td>
                                    <td class="py-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="avatar-small">{{{childavatar}}}</div>
                                            <span class="fw-semibold text-dark">{{childname}}</span>
                                        </div>
                                    </td>
                                    <td class="py-3 text-end">
                                        <span class="fw-bold text-dark font-monospace fs-6">{{formattedamount}} {{currency}}</span>
                                    </td>
                                    <td class="py-3 text-center">
                                        <a href="{{config.wwwroot}}/local/parentportal/index.php?tab=finances&action=removefromcart&cartindex={{index}}&sesskey={{sesskey}}" class="btn btn-outline-danger btn-sm rounded-circle p-1 d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" title="{{#str}}action_remove, local_parentportal{{/str}}">
                                            <i class="fa fa-times"></i>
                                        </a>
                                    </td>
                                </tr>
                                {{/cartitems}}
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                        <a href="{{config.wwwroot}}/local/smartcatalog/index.php" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                            <i class="fa fa-plus me-1"></i> Add More Courses
                        </a>
                        <a href="{{config.wwwroot}}/local/parentportal/index.php?tab=finances&action=clearcart&sesskey={{sesskey}}" class="btn btn-link text-danger btn-sm text-decoration-none">
                            <i class="fa fa-trash-alt me-1"></i> {{#str}}action_clearcart, local_parentportal{{/str}}
                        </a>
                    </div>
                    {{/hascartitems}}

                    {{^hascartitems}}
                    <!-- Empty Cart State -->
                    <div class="text-center py-5">
                        <div class="rounded-circle bg-light text-muted p-4 d-inline-flex align-items-center justify-content-center mb-3" style="width: 72px; height: 72px;">
                            <i class="fa fa-shopping-basket fa-2x"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-1">{{#str}}cart_empty_title, local_parentportal{{/str}}</h5>
                        <p class="text-muted small mx-auto mb-4" style="max-width: 420px;">
                            {{#str}}cart_empty_desc, local_parentportal{{/str}}
                        </p>
                        <a href="{{config.wwwroot}}/local/smartcatalog/index.php" class="btn btn-primary rounded-pill px-4">
                            <i class="fa fa-store me-1"></i> {{#str}}explorecourses, local_parentportal{{/str}}
                        </a>
                    </div>
                    {{/hascartitems}}
                </div>
            </div>
        </div>

        <!-- Checkout & Financial Summary Column -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 parentportal-summary-card">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="fa fa-receipt text-success me-2"></i>Summary
                    </h5>
                </div>
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <!-- Summary Breakdown -->
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="text-muted">{{#str}}cart_subtotal, local_parentportal{{/str}}</span>
                            <span class="fw-bold text-dark font-monospace fs-6">{{carttotals.formatted_subtotal}} {{carttotals.currency}}</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="text-muted">{{#str}}walletbalance, local_parentportal{{/str}}</span>
                            <span class="fw-semibold text-success font-monospace">{{carttotals.formatted_wallet}} {{carttotals.currency}}</span>
                        </div>
                        <hr class="my-3">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <span class="fw-bold text-dark">{{#str}}cart_balance_after, local_parentportal{{/str}}</span>
                            <span class="fw-bold fs-5 {{#carttotals.has_insufficient}}text-danger{{/carttotals.has_insufficient}}{{^carttotals.has_insufficient}}text-primary{{/carttotals.has_insufficient}} font-monospace">
                                {{carttotals.formatted_after}} {{carttotals.currency}}
                            </span>
                        </div>

                        <!-- Insufficient Balance Alert -->
                        {{#carttotals.has_insufficient}}
                        <div class="alert alert-warning rounded-3 border-0 small mb-3">
                            <i class="fa fa-exclamation-triangle me-1"></i>
                            {{#str}}cart_insufficient_warning, local_parentportal, {{carttotals.formatted_missing}} {{carttotals.currency}}{{/str}}
                        </div>
                        {{/carttotals.has_insufficient}}
                    </div>

                    <div>
                        {{#carttotals.can_checkout}}
                        <a href="{{config.wwwroot}}/local/parentportal/index.php?tab=finances&action=checkout&sesskey={{sesskey}}" class="btn btn-primary rounded-pill w-100 py-3 fw-bold shadow-sm" onclick="return confirm('Confirm purchase: {{carttotals.formatted_subtotal}} {{carttotals.currency}} will be debited from your wallet to enroll your children.');">
                            <i class="fa fa-check-circle me-1"></i> {{#str}}cart_checkout_btn, local_parentportal{{/str}}
                        </a>
                        {{/carttotals.can_checkout}}

                        {{#carttotals.has_insufficient}}
                        <a href="{{config.wwwroot}}/enrol/wallet/wallet.php" class="btn btn-success rounded-pill w-100 py-3 fw-bold shadow-sm">
                            <i class="fa fa-plus-circle me-1"></i> Top Up {{carttotals.formatted_missing}} {{carttotals.currency}} Now
                        </a>
                        {{/carttotals.has_insufficient}}

                        {{^hascartitems}}
                        <button class="btn btn-light border text-muted rounded-pill w-100 py-3 fw-semibold" disabled>
                            {{#str}}cart_empty, local_parentportal{{/str}}
                        </button>
                        {{/hascartitems}}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Billing & Order History Section -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
            <div>
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="fa fa-history text-secondary me-2"></i>{{#str}}billing_history_title, local_parentportal{{/str}}
                </h5>
                <small class="text-muted">Completed course purchase transactions</small>
            </div>
        </div>
        <div class="card-body p-4">
            {{#hasorders}}
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="border-0 rounded-start">{{#str}}order_date, local_parentportal{{/str}}</th>
                            <th scope="col" class="border-0">{{#str}}order_child, local_parentportal{{/str}}</th>
                            <th scope="col" class="border-0">{{#str}}order_course, local_parentportal{{/str}}</th>
                            <th scope="col" class="border-0">{{#str}}order_amount, local_parentportal{{/str}}</th>
                            <th scope="col" class="border-0">{{#str}}order_method, local_parentportal{{/str}}</th>
                            <th scope="col" class="border-0 rounded-end text-center">{{#str}}order_status, local_parentportal{{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#parentorders}}
                        <tr>
                            <td class="text-muted small">{{formatteddate}}</td>
                            <td class="fw-semibold text-dark">{{childname}}</td>
                            <td>{{coursename}}</td>
                            <td class="fw-bold font-monospace">{{formattedamount}}</td>
                            <td>
                                <span class="badge bg-light text-dark border rounded-pill">{{paymentmethod}}</span>
                            </td>
                            <td class="text-center">
                                <span class="badge {{statusbadge}} rounded-pill px-3 py-1">
                                    {{#str}}order_completed, local_parentportal{{/str}}
                                </span>
                            </td>
                        </tr>
                        {{/parentorders}}
                    </tbody>
                </table>
            </div>
            {{/hasorders}}

            {{^hasorders}}
            <div class="text-center py-4">
                <div class="rounded-circle bg-light text-muted p-3 d-inline-flex align-items-center justify-content-center mb-2" style="width: 52px; height: 52px;">
                    <i class="fa fa-file-invoice fa-lg"></i>
                </div>
                <p class="text-muted small mb-0">{{#str}}no_orders_recorded, local_parentportal{{/str}}</p>
            </div>
            {{/hasorders}}
        </div>
    </div>
</div>

